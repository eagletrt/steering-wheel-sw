digraph "steering_wheel_fsm" {
    bgcolor="white"
    layout="dot"
    center=true
    concentrate=false

    init [
        style="filled"
        color="#66ff66"
        fillcolor="#c1ffc1"
    ]

    idle
    flash

    error [
        style="filled"
        color="#ff6666"
        fillcolor="#ffc1c1"
    ]

    ts_on
    drive
    autonomous

    // ========================
    // Init transitions
    // ========================
    init -> idle  [label="init_done"]
    init -> error [label="init_error"]

    // ========================
    // Idle transitions
    // ========================
    idle -> ts_on        [label="ts_on_request"]
    idle -> autonomous  [label="autonomous_enable"]
    idle -> flash       [label="start_flash"]
    idle -> error       [label="error_detected"]
    idle -> idle

    // ========================
    // TS-on transitions
    // ========================
    ts_on -> drive [label="ts_on_accepted"]
    ts_on -> idle  [label="ts_cancel"]
    ts_on -> error [label="error_detected"]

    // ========================
    // Drive transitions
    // ========================
    drive -> idle  [label="ts_off"]
    drive -> error [label="error_detected"]

    // ========================
    // Autonomous transitions
    // ========================
    autonomous -> idle  [label="autonomous_disable"]
    autonomous -> error [label="error_detected"]

    // ========================
    // Flash transitions
    // ========================
    flash -> flash
    flash -> idle  [label="flash_done"]
    flash -> error [label="error_detected"]

    // ========================
    // Error transitions
    // ========================
    error -> error
}
